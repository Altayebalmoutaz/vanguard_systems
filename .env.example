# Copy to .env and fill in (Supabase: Project Settings → API)

# --- Application Postgres (Supabase-only pilot) ---
# DATABASE_URL is the canonical psycopg DSN for platform/rcm/agents data. For the
# pilot, point it at the SAME Supabase project's Postgres (Settings → Database →
# direct or session-pooler connection string). NEON_DATABASE_URL still works as a
# legacy alias only.
# Apply the schema in order: python scripts/apply_schema_migrations.py
# (see schema/migrations/README.md — includes realtime NOTIFY triggers (008) and
# OpenDental connections (009)).
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres

SUPABASE_URL=
# Server: prefer SUPABASE_SERVICE_ROLE_KEY (bypasses RLS). Otherwise use anon + policies (see supabase/migrations/003).
SUPABASE_SERVICE_ROLE_KEY=
# Eligibility agent also accepts SUPABASE_KEY (same value as service role if you prefer that name).
# SUPABASE_KEY=

# Eligibility POST /eligibility/check optional fields — with migration 040 mock seeds:
# practice_id=vgd_mock_brooklyn, rendering_provider_npi=1104023674, optional provider_service_location_key=site_main
# Layer 5 uses provider_payer_network.in_network_for_fees (fee path) vs Stedi 271 in_network (audit).

# Layer 5: when payer_fee_schedules has no row for a CDT, fill illustrative UCR (off by default).
# ELIGIBILITY_UCR_FALLBACK_ENABLED=true
# Optional JSON overrides: {"D1110": 200, "D2740": 1200}
# ELIGIBILITY_UCR_FALLBACK_JSON=

# Optional: provider_organization_name (Stedi provider.organizationName), provider_first_name / provider_last_name.

# Stedi eligibility — https://www.stedi.com/docs (healthcare API key)
STEDI_API_KEY=
# Set true when using Stedi test key + official dental mock scenarios (sends stedi-test: true).
# STEDI_TEST_HEADER=true
# Optional overrides; defaults are mock-safe for sandbox (see eligibility_agent/config.py).
# PROVIDER_NPI=
# PROVIDER_NAME=
# PROVIDER_TAX_ID=

# Stedi 837 (claim submission) — separate Healthcare Claims API key, may be the
# same project as eligibility but is checked independently so claims can stay in
# mock mode while eligibility runs live, or vice versa.
# When unset, submit_claim_tool raises unless ALLOW_CLAIM_MOCK_SUBMISSION=true
# (local dev / tests only — never in production).
# STEDI_CLAIMS_API_KEY=
# ALLOW_CLAIM_MOCK_SUBMISSION=false
# STEDI_CLAIMS_BASE_URL=https://healthcare.us.stedi.com
# STEDI_CLAIMS_DENTAL_PATH=/2024-04-01/change/medical/claims
# STEDI_CLAIMS_TEST_HEADER=true
# STEDI_CLAIMS_TIMEOUT_SECONDS=30
# scripts/backfill_cdt_embeddings.py also accepts:
# SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Optional: database password (Settings → Database) for scripts/apply_rcm_schema.py — or set DATABASE_URL instead.
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres

# --- Observability (Wave 1C app hardening) ---
# Structured JSON logs to stdout; correlation IDs on every HTTP request (X-Correlation-ID).
# LOG_LEVEL=INFO
# ENVIRONMENT=development
# Sentry error tracking — https://sentry.io (leave unset locally)
# SENTRY_DSN=
# Dashboard (Next.js) Sentry — set in eligibility_dashboard env; no-op when unset.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# --- Durable pipeline worker (Phase 3) ---
# Requires DATABASE_URL. Processes platform.pipeline_runs queue.
# REQUIRED in production (startup guard fails fast if off) — otherwise
# dashboard-submitted requests are never processed.
# PIPELINE_WORKER_ENABLED=false
# PIPELINE_WORKER_INTERVAL_SECONDS=5
# PIPELINE_WORKER_BATCH_SIZE=5
# PIPELINE_RETRY_DELAY_SECONDS=30
# CONFIDENCE_HITL_THRESHOLD=0.85

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_TIMEOUT_SECONDS=120
# OPENROUTER_MAX_RETRIES=3

# Jina embeddings — https://jina.ai/
# JINA_API_KEY=
# JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
# JINA_EMBEDDING_DIMENSIONS=1024
# JINA_BATCH_SIZE=10
# Coding agent: with JINA_API_KEY + Supabase, injects pgvector `match_cdt_codes` hints into the coding LLM prompt.
# CDT_VECTOR_MATCH_COUNT=8
# CDT_VECTOR_MATCH_THRESHOLD=0.3
# Optional: only rows with this status (otherwise all rows with null embedding)
# CDT_EMBED_STATUS=active
# scripts/backfill_cdt_embeddings.py (Vanguard CDT backfill) also reads SUPABASE_SERVICE_KEY (or SUPABASE_SERVICE_ROLE_KEY).

# --- Authentication (production) ---
# Flip to 1 in any non-local deployment. When on, every non-/health route requires
# Authorization: Bearer <Supabase JWT> OR X-API-Key: <one of INTERNAL_API_KEYS>.
# Also set ENVIRONMENT=production so the app fails fast if REQUIRE_AUTH is still off.
# ENVIRONMENT=development
# REQUIRE_AUTH=0
# HS256 secret for verifying Supabase user JWTs (Project Settings → API → JWT Settings).
# SUPABASE_JWT_SECRET=
# Comma-separated allow-list of static API keys for trusted server-to-server callers
# (Supabase edge functions, batch jobs, ops scripts). Keep entries 32+ random chars.
# INTERNAL_API_KEYS=svc-key-1,svc-key-2
# Phase 1.2 RBAC: production requires staff users to resolve to
# platform.user_practice_roles rows in Neon. Local/dev can leave this off and
# optionally use Supabase JWT app_metadata.role / app_metadata.practice_roles
# for dashboard nav previews.
# REQUIRE_RBAC=0
# (RBAC reads platform.user_practice_roles via DATABASE_URL — see top of file.)
#
# Production startup guards (ENVIRONMENT=production) additionally require:
#   REQUIRE_AUTH=1, REQUIRE_RBAC=1, DATABASE_URL, PIPELINE_WORKER_ENABLED=1,
#   ELIGIBILITY_AGENT_API_KEY, and TWILIO_AUTH_TOKEN when voice is enabled.

# --- Dashboard staff auth (eligibility_dashboard/) ---
# Same Supabase project as above — staff logins only; patient PHI never touches Auth.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Require staff login before any dashboard route (auto-on when NODE_ENV=production
# and Supabase public vars are set). Force in staging with:
# DASHBOARD_REQUIRE_AUTH=1
# Practice tenant used by server-side BFF routes when calling FastAPI with RCM_API_KEY.
# DASHBOARD_PRACTICE_ID=vgd_mock_brooklyn
#
# Realtime: the dashboard subscribes to /api/dashboard/eligibility/stream (SSE
# proxied by the Next.js BFF to FastAPI, backed by Postgres LISTEN/NOTIFY from
# migration 008). No extra env needed, but any reverse proxy in front of the BFF
# must not buffer text/event-stream responses. A 30s fallback poll covers gaps.

# --- Eligibility webhook (Supabase Edge → local FastAPI via ngrok) ---
# Vault secret `eligibility_agent_check_url` (or Edge ELIGIBILITY_AGENT_CHECK_URL) must match HOW you run uvicorn:
#
#   • Full app (recommended if you already use port 8000):
#       uvicorn app.main:app --host 0.0.0.0 --port 8000
#       ngrok http 8000
#       URL: https://<subdomain>.ngrok-free.app/eligibility-agent/eligibility/check
#
#   • Eligibility-only app on 8010:
#       uvicorn app.eligibility.main:app --host 0.0.0.0 --port 8010
#       ngrok http 8010
#       URL: https://<subdomain>.ngrok-free.app/eligibility/check
#
# Wrong path for the mode you use → HTTP 404 → dashboard shows AGENT_ERROR / "Not Found".
# Same random value on FastAPI and Supabase Edge for `ELIGIBILITY_AGENT_API_KEY`:
# ELIGIBILITY_AGENT_API_KEY=
#
# Webhook HMAC signing (migration 045): the Edge Function verifies an
# `X-Webhook-Signature` header that the DB trigger computes. Set the SAME value as
# the function's WEBHOOK_SECRET env var AND the Vault secret
# `eligibility_dashboard_edge_function_signing_secret` (32+ random chars).
# WEBHOOK_SECRET=

# --- Eligibility retry worker (in-process background task; migration 045) ---
# Re-queues 'retrying' requests whose next_retry_at is due. Honors the live
# dashboard toggle eligibility_agent_settings.auto_retry_enabled.
# ELIGIBILITY_RETRY_WORKER_ENABLED=false
# ELIGIBILITY_RETRY_WORKER_INTERVAL_SECONDS=60
# ELIGIBILITY_RETRY_BATCH_SIZE=20

# --- Wave 7: Neon pipeline dispatch (replaces Supabase Edge Function) ---
# Enable the in-process pipeline worker so eligibility requests and OD writebacks
# run via platform.pipeline_runs (not the Supabase edge function).
# --- Wave 9: shadow pilot (read-only OD, ROI instrumentation) ---
# PILOT_SHADOW_MODE=1 blocks OD write-back and clearinghouse claim submit.
# Set PILOT_DEFAULT_PRACTICE_ID for background workers when requests lack practice_id.
# Apply schema/migrations/007_pilot_shadow.sql before enabling.
# PILOT_SHADOW_MODE=false
# PILOT_DEFAULT_PRACTICE_ID=

# and 047_supabase_phi_cleanup.sql on the Supabase project to drop triggers and revoke PHI access.

# --- Voice payer verification (Bland.ai primary; Twilio scripted fallback) ---
# VOICE_VERIFICATION_ENABLED=true deploys the voice stack (Bland credentials below).
# Runtime on/off per practice: eligibility dashboard → Agent controls → Voice enabled.
# Auto-call queues after Stedi when INCOMPLETE/COVERAGE_AMBIGUOUS and payer phone exists.
# VOICE_VERIFICATION_ENABLED=true
# VOICE_VERIFICATION_WORKER_ENABLED=true
# VOICE_VERIFICATION_WORKER_INTERVAL_SECONDS=30
# VOICE_VERIFICATION_BATCH_SIZE=5
# VOICE_CALL_PROVIDER=bland
# BLAND_API_KEY=
# BLAND_PATHWAY_ID=
# Pilot default is prompt mode (persona + real patient data live in our code, not a
# Bland Pathway). Set BLAND_USE_PATHWAY=true to route through BLAND_PATHWAY_ID instead.
# BLAND_USE_PATHWAY=false
# Natural conversational voice (curated name like june/maya/nat, or a voice_id from
# GET /v1/voices). Leave blank to use the Bland account default.
# BLAND_VOICE=june
# Model: base | turbo. Use "base" for payer calls — it supports IVR/phone-menu
# navigation, which "turbo" excludes. turbo is lower-latency but cannot navigate menus.
# BLAND_MODEL=base
# Human-feel tuning for prompt mode (optional; blank = Bland defaults):
# BLAND_TEMPERATURE=0.7
# BLAND_INTERRUPTION_THRESHOLD=120
# Public HTTPS base for Bland webhooks (alias: TWILIO_WEBHOOK_BASE_URL):
# VOICE_WEBHOOK_BASE_URL=https://<backend>/eligibility-agent
# Twilio fallback only when VOICE_CALL_PROVIDER=twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# VOICE_OPENAI_API_KEY=
# VOICE_OPENAI_MODEL=gpt-4o-mini
# VOICE_AUTO_APPROVE_WHEN_COMPLETE=true
# Demo without live calls:
# VOICE_DEMO_AUTO_COMPLETE=false
# VOICE_DEMO_TRANSCRIPT=Member is active. Annual max remaining 1500. Deductible remaining 50. Reference number REF-DEMO-001.

# --- OpenDental ---
# Multi-clinic (recommended): Open Dental hosted Remote API
# (https://api.opendental.com/api/v1) + eConnector on the clinic machine.
# One row per clinic in rcm.opendental_connections (migrations 009 + 012) —
# managed from the dashboard "OpenDental" page (poll toggle, test, poll now).
#   * OPENDENTAL_DEVELOPER_KEY is OUR single developer secret (env only).
#   * Each clinic's Customer key lives in its own env var; the connection row's
#     customer_key_ref names that env var (e.g. OD_CUSTOMER_KEY_VGD_BROOKLYN).
#     Keys are never stored in the database or shown in the dashboard.
# OD_CUSTOMER_KEY_VGD_BROOKLYN=
#
# Single-clinic / demo fallback (no connection rows): Local API on the same
# Windows machine (inside opendental.exe): http://localhost:30222/api/v1
OPENDENTAL_BASE_URL=https://api.opendental.com/api/v1
# Required auth for all API modes: Authorization: ODFHIR {DeveloperKey}/{CustomerKey}
OPENDENTAL_DEVELOPER_KEY=
OPENDENTAL_CUSTOMER_KEY=
OPENDENTAL_TIMEOUT_SECONDS=15
# Full writeback go-live (also set writeback_enabled/writeback_full on the connection row).
# PILOT_SHADOW_MODE is an emergency kill-switch only — not the planned rollout path.
OPENDENTAL_WRITEBACK_ENABLED=true
OPENDENTAL_WRITE_BENEFIT_NOTES_ENABLED=true
OPENDENTAL_WRITE_SUBSCRIBER_NOTE_ENABLED=true
OPENDENTAL_WRITE_COMMLOG_ENABLED=true
OPENDENTAL_WRITE_INSHIST_ENABLED=true
OPENDENTAL_WRITE_INSADJUST_ENABLED=true
OPENDENTAL_WRITE_BENEFITS_GRID_ENABLED=true
# Large-delta review gate (default off for full writeback demos; true for cautious pilots).
OPENDENTAL_WRITE_BENEFITS_GRID_CONFIDENCE_GATING=false
# Optional replay mode (tests/demo fallback): read fixtures instead of HTTP calls.
# OPENDENTAL_REPLAY_DIR=tests/fixtures/opendental
# OPENDENTAL_AUTO_POLL_ENABLED=false
# PILOT_SHADOW_MODE=false
# PILOT_DEFAULT_PRACTICE_ID=vgd_mock_brooklyn
