# Copy to .env.local and fill in values.
# Next.js only loads env from this directory — not the repo-root .env.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side BFF → FastAPI (uvicorn must be running on this host/port).
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Must match INTERNAL_API_KEYS in the repo-root .env
RCM_API_KEY=vanguard-local-dev-key

# Practice tenant for dashboard reads/writes
DASHBOARD_PRACTICE_ID=vgd_mock_brooklyn
