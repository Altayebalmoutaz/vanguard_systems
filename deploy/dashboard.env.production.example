# =============================================================================
# Dashboard (Next.js) production env — copy to deploy/dashboard.env.production
# on the VM (NEVER commit).
#
# Consumed by:
#   - docker-compose.prod.yml → frontend service (env_file, runtime)
#   - NEXT_PUBLIC_* also required as shell/env for compose build-arg
#     interpolation. Before `docker compose ... --build`, run:
#       set -a && . ./deploy/dashboard.env.production && set +a
# =============================================================================

# --- Public Supabase (baked into the client bundle at image build time) ---
# Source: Supabase Dashboard → Project Settings → API
# Staff Auth only — patient PHI must not go through the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME=ezFi
NEXT_PUBLIC_APP_SUBTITLE="Eligibility Agent"
# Optional frontend Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# --- Server-side BFF → FastAPI (runtime; overridden in compose to backend:8000) ---
# Keep this value for documentation; compose sets FASTAPI_BASE_URL=http://backend:8000.
FASTAPI_BASE_URL=http://backend:8000

# Must match ONE entry in backend INTERNAL_API_KEYS (deploy/.env.production).
# Generate: openssl rand -hex 32
RCM_API_KEY=

# Practice tenant used by BFF routes when calling FastAPI with RCM_API_KEY.
DASHBOARD_PRACTICE_ID=vgd_mock_brooklyn

# Require staff login (auto-on in NODE_ENV=production when Supabase public vars set;
# force explicitly for clarity).
DASHBOARD_REQUIRE_AUTH=1
