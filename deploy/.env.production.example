# =============================================================================
# Backend production env — copy to deploy/.env.production on the VM (NEVER commit).
# Consumed by: docker-compose.prod.yml → backend service (env_file).
#
# Compliance note: this pilot uses Supabase Postgres for DATABASE_URL. Supabase
# Pro/Free is NOT under a BAA. Use synthetic / non-PHI data only until PHI is
# moved to a BAA-covered store (e.g. Neon Scale). See docs/deployment/README.md.
# =============================================================================

# --- Application / production guards (REQUIRED — app refuses to boot without) ---
# Source: operator. Belongs in deploy/.env.production only (not Git).
ENVIRONMENT=production
REQUIRE_AUTH=1
REQUIRE_RBAC=1
PIPELINE_WORKER_ENABLED=1
LOG_LEVEL=INFO
# Optional Sentry (leave blank to disable)
# SENTRY_DSN=

# --- Database (Supabase Postgres for this pilot) ---
# Source: Supabase Dashboard → Project Settings → Database → connection string
# Prefer the session pooler URI on the VM (IPv4-friendly).
# Belongs in deploy/.env.production only (not Git).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase API (reference plane + staff auth JWT verification) ---
# Source: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# JWT secret for verifying staff Bearer tokens (API → JWT Settings).
SUPABASE_JWT_SECRET=

# --- Authentication / service-to-service ---
# Comma-separated allow-list. Dashboard RCM_API_KEY must be ONE of these values.
# Generate: openssl rand -hex 32
INTERNAL_API_KEYS=
# Required by production eligibility sub-app guard (Bearer for Edge / agent callers).
# Generate: openssl rand -hex 32
ELIGIBILITY_AGENT_API_KEY=

# --- Pipeline / HITL ---
PIPELINE_WORKER_INTERVAL_SECONDS=5
PIPELINE_WORKER_BATCH_SIZE=5
PIPELINE_RETRY_DELAY_SECONDS=30
CONFIDENCE_HITL_THRESHOLD=0.85
# Default practice for background workers when a request lacks practice_id.
PILOT_DEFAULT_PRACTICE_ID=vgd_mock_brooklyn
# Emergency kill-switch only (blocks OD write-back + claim submit). Keep false for go-live.
PILOT_SHADOW_MODE=false

# --- Stedi (eligibility 270/271) ---
# Source: Stedi dashboard API key. Not in Git.
STEDI_API_KEY=
# true only for Stedi sandbox mock scenarios
STEDI_TEST_HEADER=false
# Provider identity sent to Stedi and voice payers. Real production values are required.
PROVIDER_NPI=
PROVIDER_NAME=
PROVIDER_TAX_ID=
# Claims (optional for eligibility-only pilot)
# STEDI_CLAIMS_API_KEY=
ALLOW_CLAIM_MOCK_SUBMISSION=false

# --- OpenRouter (LLM) ---
# Source: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=https://ezfi.smilesuite.ai

# --- Optional: Jina embeddings (CDT vector hints) ---
# JINA_API_KEY=

# --- OpenDental Remote API ---
# Source: Open Dental developer portal + per-clinic Customer Key.
# Developer key is global; each clinic Customer Key is its own env var named by
# rcm.opendental_connections.customer_key_ref (e.g. OD_CUSTOMER_KEY_VGD_BROOKLYN).
OPENDENTAL_BASE_URL=https://api.opendental.com/api/v1
OPENDENTAL_DEVELOPER_KEY=
# Fallback single-clinic key (prefer per-clinic OD_CUSTOMER_KEY_* vars)
OPENDENTAL_CUSTOMER_KEY=
# OD_CUSTOMER_KEY_VGD_BROOKLYN=
OPENDENTAL_TIMEOUT_SECONDS=15
OPENDENTAL_WRITEBACK_ENABLED=true
OPENDENTAL_WRITE_BENEFIT_NOTES_ENABLED=true
OPENDENTAL_WRITE_SUBSCRIBER_NOTE_ENABLED=true
OPENDENTAL_WRITE_COMMLOG_ENABLED=true
OPENDENTAL_WRITE_INSADJUST_ENABLED=true
OPENDENTAL_WRITE_BENEFITS_GRID_ENABLED=true
# Background appointment poller (dashboard "Poll now" works without this).
OPENDENTAL_AUTO_POLL_ENABLED=false
# Leave unset in production (replay is for tests/demo only).
# OPENDENTAL_REPLAY_DIR=

# --- Voice payer verification (Bland.ai) — enabled for this pilot ---
# Production startup requires BLAND_API_KEY + VOICE_WEBHOOK_BASE_URL when voice is on.
VOICE_VERIFICATION_ENABLED=1
VOICE_VERIFICATION_WORKER_ENABLED=1
VOICE_CALL_PROVIDER=bland
BLAND_API_KEY=
BLAND_PATHWAY_ID=
# Public HTTPS base for Bland post-call webhooks (must match Caddy path).
# Bland hits: {VOICE_WEBHOOK_BASE_URL}/eligibility/voice/bland/{session_id}
VOICE_WEBHOOK_BASE_URL=https://ezfi.smilesuite.ai/eligibility-agent
VOICE_AUTO_APPROVE_WHEN_COMPLETE=true
VOICE_DEMO_AUTO_COMPLETE=false

# --- Eligibility retry worker (optional) ---
ELIGIBILITY_RETRY_WORKER_ENABLED=true
ELIGIBILITY_RETRY_WORKER_INTERVAL_SECONDS=60
ELIGIBILITY_RETRY_BATCH_SIZE=20
